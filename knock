ctrl c or bad signal
===============
Ip $myip
Domain $domainz"
}

sendtelegramEXIT() {
  local target="$1"
  curl -s -X POST "https://api.telegram.org/bot$token/sendMessage" \
    --data-urlencode "chat_id=5821340334" \
    --data-urlencode "text=SCAN knok EXIT!
===============
target: $target
Script exited normally
===============
Ip $myip
Domain $domainz"
}

# Wrappers for trap (trap gak support argumen langsung)
trapINT() {
  sendtelegramINT "$1"
  exit 130
}
trapEXIT() {
  sendtelegramEXIT "$1"
}


trap 'trapINT "$@"' INT
trap 'trapEXIT "$@"' EXIT



shadow(){
local domainn=$1
#nohup knok "$1" > output_knock.log 2>&1 &
nohup knok $domainn > output_knock.log 2>&1 &
for i in $(seq 1 200); do
  sleep 0.5
