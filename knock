#!/bin/bash
set -euo pipefail
IFS=$'\n\t'

token="6654578153:AAEL08DFbdrgtirDqtBU6DkP_acq31uZPik"
myip=$(curl -s ipv4.icanhazip.com)
domainz=$(cat /etc/xray/domain)

sendtelegramINT() {
  local target="$1"
  curl -s -X POST "https://api.telegram.org/bot6654578153:AAEL08DFbdrgtirDqtBU6DkP_acq31uZPik/sendMessage" -d chat_id="5821340334" -d text="
SCAN knok INT!
===============
target: $target
