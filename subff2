# quick function to fetch from an endpoint (no heavy retry to keep speed)
fetch_to_stdout(){
  local url="$1"
  curl --connect-timeout 5 -m 10 -A "$UA" -sL "$url" -c "$COOKIE" -b "$COOKIE" || return 1
}

display_header
# Collect subs from multiple sources (fast, no heavy parsing)
echo "Collecting subdomains (parallel-ready) ..."

fetch_to_stdout "https://crt.sh/?q=$TARGET" | grep -Po '(?<=<TD>)[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}' 2>/dev/null >> "$TMP_ALL" || true
fetch_to_stdout "https://api.certspotter.com/v1/issuances?domain=$TARGET&include_subdomains=true&expand=dns_names" | grep -Po '(?<=\"dns_names\":\[\")[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}' 2>/dev/null >> "$TMP_ALL" || true
fetch_to_stdout "https://otx.alienvault.com/api/v1/indicators/domain/$TARGET/passive_dns" | grep -Po '(?<=\"hostname\": \")[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}' 2>/dev/null >> "$TMP_ALL" || true
fetch_to_stdout "https://api.hackertarget.com/hostsearch/?q=$TARGET" | grep -Po '[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}' 2>/dev/null >> "$TMP_ALL" || true
fetch_to_stdout "https://web.archive.org/cdx/search/cdx?url=*.$TARGET/*&output=txt&fl=original&collapse=urlkey" | grep -Po '(?<=https:\/\/)[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}' 2>/dev/null >> "$TMP_ALL" || true
fetch_to_stdout "https://jonlu.ca/anubis/subdomains/$TARGET" | grep -Po '[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}' 2>/dev/null >> "$TMP_ALL" || true


#sort -u "$TMP_ALL" > "$OUT_DIR/unix_subs.txt" || true
sub=$(sort -u "$TMP_ALL" 2>/dev/null | grep -v "^$")
if [[ -z "$sub" ]]; then
    printf "\nSubdomain $TARGET Tidak ditemukan\n"
    rm -f $TMP_ALL $COOKIE 2>/dev/null
    exit 1
fi
# hapus cookie dan file sementara 
rm -f "$TMP_ALL" "$COOKIE" 2>/dev/null
echo "$sub" >> "$OUT_DIR/unix_subs.txt"
echo -e "\nUnix subs collected: $(wc -l < "$OUT_DIR/unix_subs.txt") subdomains\n"

# parallel resolver function (runs in xargs)
resolver_worker(){
    BLUE="\e[1;36m"
    RED="\e[1;31m"
    NC="\e[0m"
    tmp_sub="domains.txt"
    tmp_ip="ips.txt"
    host="$1"
    if command -v host &>/dev/null; then
        ip=$(host -t A "$host" 2>/dev/null | awk '/has address/ {print $4; exit}')
    else
        #ip=$(nslookup -timeout=5 -type=a "$hosts" 2>/dev/null | grep 'Address: ' | head -n 1 | awk '{print $2}')
        ip=$(nslookup -timeout=5 -type=A "$host" 2>/dev/null | awk '/Address:/ {print $2; exit}')
    fi

    if [[ -n "$ip" ]]; then
        printf "${BLUE}➤ ${NC}OK: %s | %s\n" "$host" "$ip"
        #printf "${BLUE}➤ ${NC}$host $ip\n"
        echo "$host" >> "$tmp_sub"
        echo "$ip" >> "$tmp_ip"
        printf "%s\n%s\n" "$host" "$ip" >> "sub_ip.txt"
        
    else
        #printf "${BLUE}➤ ${RED}$host ${NC}\n"
        printf "${BLUE}➤ ${RED}SKIP🔻: %s\n" "$host"
    fi
}

export -f resolver_worker

# Run parallel (20 threads)
#cat "$OUT_DIR/unix_subs.txt" | grep -v '^$' | xargs -P 20 -I {} bash -c 'resolver_worker "$@"' _ {}
cat "$OUT_DIR/unix_subs.txt" | grep -v '^$' | xargs -P 8 -I {} bash -c 'resolver_worker "$@"' _ {}
printf "${NC}=================================\n"

printf "\nTotal Subdomain sorted : $(wc -l < "$tmp_sub") subdomain \n"

result_sub=$(sort -u "$tmp_sub" 2>/dev/null | grep -v '^$')
result_ip=$(sort -u "$tmp_ip" 2>/dev/null | grep -v '^$')

# Aggregate results
> "$FINAL_SUBS"
> "$FINAL_IPS"

echo "$result_sub" >> "$FINAL_SUBS"
echo "$result_ip" >> "$FINAL_IPS"

cp -f "$FINAL_SUBS" "$ONLY_SUBS"
cp -f "$FINAL_IPS" "$ONLY_IPS"

cp -f "$FINAL_SUBS" "$HOME/domains.txt"
cp -f "$FINAL_IPS" "$HOME/ips.txt"

# finalize unique pairs
paste -d'|' "$FINAL_SUBS" "$FINAL_IPS" > "$FINAL_JOIN" || true

mv sub_ip.txt $OUT_DIR/sub_ip.txt
echo "Done. Results in $OUT_DIR"
